# Keep the build context small. Both images build from the repo root.

.git
.cursor
.venv
.pytest_cache
__pycache__
*.pyc
.DS_Store

# Large or generated: the elevation file is mounted at run time, not baked in.
dem/*.TIF
dem/*.tif
server/cache

# Tests and their fixtures do not ship.
pipeline/tests

# The web image installs its own dependencies and builds its own dist.
web/node_modules
web/dist

# Docs and local notes are not needed in any image.
*.md
!content/**
